{
  "_template": "carousel-middle",
  "_description": "Propulsar brand — 1:1 carousel middle slide. Canonical layout: image right (~46% width), text left. This is the template exercised by the real 'veterinaria s.' overflow regression test (2026-07-20 slide 2) — headline uses auto-fit (font_size:null + min/max) inside a fixed-width left column so it shrinks instead of breaking mid-word. Placeholders ({{HEADLINE}}, {{BODY}}, {{BADGE}}, {{BACKGROUND_URL}}) are substituted by scripts/eval-design-engines.js before POSTing this JSON as the `source` field.",
  "output_format": "png",
  "width": 1080,
  "height": 1080,
  "elements": [
    {
      "type": "shape",
      "name": "base-gradient",
      "x": "50%",
      "y": "50%",
      "width": "100%",
      "height": "100%",
      "fill_mode": "linear",
      "fill_x0": "50%",
      "fill_y0": "0%",
      "fill_x1": "50%",
      "fill_y1": "100%",
      "fill_color": [
        { "offset": "0%", "color": "#070A18" },
        { "offset": "50%", "color": "#13082B" },
        { "offset": "100%", "color": "#08031A" }
      ]
    },
    {
      "type": "shape",
      "name": "magenta-glow",
      "x": "18%",
      "y": "4%",
      "width": "70%",
      "height": "48%",
      "fill_mode": "radial",
      "fill_x0": "50%",
      "fill_y0": "0%",
      "fill_x1": "50%",
      "fill_y1": "100%",
      "fill_radius": "65%",
      "fill_color": [
        { "offset": "0%", "color": "rgba(162,0,214,0.28)" },
        { "offset": "100%", "color": "rgba(162,0,214,0)" }
      ]
    },
    {
      "type": "image",
      "name": "side-image",
      "source": "{{BACKGROUND_URL}}",
      "x": "100%",
      "x_anchor": "100%",
      "y": "50%",
      "y_anchor": "50%",
      "width": "46%",
      "height": "100%",
      "fit": "cover"
    },
    {
      "type": "shape",
      "name": "seam-fade",
