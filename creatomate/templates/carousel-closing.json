{
  "_template": "carousel-closing",
  "_description": "Propulsar brand — 1:1 carousel closing slide. Canonical layout: no image, blank dark gradient background, centered text + CTA line. Placeholders ({{HEADLINE}}, {{BODY}}, {{BADGE}}, {{CTA}}) are substituted by scripts/eval-design-engines.js before POSTing this JSON as the `source` field. No BACKGROUND_URL token — this template never uses an image element.",
  "output_format": "png",
  "width": 1080,
  "height": 1080,
  "elements": [
    {
      "type": "shape",
      "name": "base-gradient",
      "x": "50%",
      "y": "50%",
      "width": "100%",
      "height": "100%",
      "fill_mode": "linear",
      "fill_x0": "50%",
      "fill_y0": "0%",
      "fill_x1": "50%",
      "fill_y1": "100%",
      "fill_color": [
        { "offset": "0%", "color": "#070A18" },
        { "offset": "50%", "color": "#13082B" },
        { "offset": "100%", "color": "#08031A" }
      ]
    },
    {
      "type": "shape",
      "name": "magenta-glow",
      "x": "50%",
      "y": "50%",
      "width": "100%",
      "height": "70%",
      "fill_mode": "radial",
      "fill_x0": "50%",
      "fill_y0": "50%",
      "fill_x1": "100%",
      "fill_y1": "50%",
      "fill_radius": "58%",
      "fill_color": [
        { "offset": "0%", "color": "rgba(162,0,214,0.22)" },
        { "offset": "100%", "color": "rgba(162,0,214,0)" }
      ]
    },
    {
      "type": "text",
