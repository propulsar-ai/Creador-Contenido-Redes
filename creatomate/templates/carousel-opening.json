{
  "_template": "carousel-opening",
  "_description": "Propulsar brand — 1:1 carousel slide 1. Canonical layout: image behind, centered text, CASO badge. Placeholders ({{HEADLINE}}, {{BODY}}, {{BADGE}}, {{BACKGROUND_URL}}) are substituted by scripts/eval-design-engines.js before POSTing this JSON as the `source` field.",
  "output_format": "png",
  "width": 1080,
  "height": 1080,
  "elements": [
    {
      "type": "image",
      "name": "background-image",
      "source": "{{BACKGROUND_URL}}",
      "x": "50%",
      "y": "50%",
      "width": "100%",
      "height": "100%",
      "fit": "cover"
    },
    {
      "type": "shape",
      "name": "darken-overlay",
      "x": "50%",
      "y": "50%",
      "width": "100%",
      "height": "100%",
      "fill_mode": "linear",
      "fill_x0": "50%",
      "fill_y0": "0%",
      "fill_x1": "50%",
      "fill_y1": "100%",
      "fill_color": [
        { "offset": "0%", "color": "rgba(7,10,24,0.12)" },
        { "offset": "42%", "color": "rgba(7,10,24,0.40)" },
        { "offset": "72%", "color": "rgba(8,3,26,0.84)" },
        { "offset": "100%", "color": "rgba(8,3,26,0.95)" }
      ]
    },
    {
      "type": "shape",
      "name": "magenta-glow",
      "x": "50%",
      "y": "4%",
      "width": "92%",
      "height": "46%",
      "fill_mode": "radial",
      "fill_x0": "50%",
      "fill_y0": "0%",
      "fill_x1": "50%",
      "fill_y1": "100%",
      "fill_radius": "65%",
      "fill_color": [
        { "offset": "0%", "color": "rgba(162,0,214,0.35)" },
        { "offset": "100%", "color": "rgba(162,0,214,0)" }
      ]
    },
    {
      "type": "text",
      "name": "badge",
      "text": "{{BADGE}}",
      "x": "50%",
      "y": "60%",
      "font_family": "Arimo",
      "font_weight": "700",
      "font_size": "26px",
      "fill_color": "#C026D3",
      "x_alignment": "50%",
      "y_alignment": "50%",
      "background_color": "#1E0C42",
      "background_x_padding": "45%",
      "background_y_padding": "55%",
      "background_border_radius": "50%"
    },
    {
      "type": "text",
      "name": "headline",
      "text": "{{HEADLINE}}",
      "x": "50%",
      "y": "76%",
      "width": "82%",
      "height": "24%",
      "font_family": "Syne",
      "font_weight": "700",
      "font_size": null,
      "font_size_minimum": "34px",
      "font_size_maximum": "64px",
      "line_height": "112%",
      "fill_color": "#FFFFFF",
      "x_alignment": "50%",
      "y_alignment": "50%",
      "text_wrap": true
    },
    {
      "type": "text",
      "name": "body",
      "text": "{{BODY}}",
      "x": "50%",
      "y": "93%",
      "width": "80%",
      "height": "10%",
      "font_family": "Arimo",
      "font_weight": "400",
      "font_size": null,
      "font_size_minimum": "18px",
      "font_size_maximum": "28px",
      "line_height": "128%",
      "fill_color": "rgba(255,255,255,0.85)",
      "x_alignment": "50%",
      "y_alignment": "50%",
      "text_wrap": true
    }
  ]
}
