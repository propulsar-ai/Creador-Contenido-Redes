{
  "_template": "story",
  "_description": "Propulsar brand — 9:16 Story. Image full-bleed, subject/text in upper-middle third, top and bottom 14% kept free of text (safe zones for platform UI chrome). Placeholders ({{HEADLINE}}, {{BODY}}, {{BADGE}}, {{BACKGROUND_URL}}) are substituted by scripts/eval-design-engines.js before POSTing this JSON as the `source` field.",
  "output_format": "png",
  "width": 1080,
  "height": 1920,
  "elements": [
    {
      "type": "image",
      "name": "background-image",
      "source": "{{BACKGROUND_URL}}",
      "x": "50%",
      "y": "50%",
      "width": "100%",
      "height": "100%",
      "fit": "cover"
    },
    {
      "type": "shape",
      "name": "text-band-overlay",
      "x": "50%",
      "y": "50%",
      "width": "100%",
      "height": "100%",
      "fill_mode": "linear",
      "fill_x0": "50%",
      "fill_y0": "0%",
      "fill_x1": "50%",
      "fill_y1": "100%",
      "fill_color": [
        { "offset": "0%", "color": "rgba(7,10,24,0.15)" },
        { "offset": "16%", "color": "rgba(7,10,24,0.78)" },
        { "offset": "64%", "color": "rgba(7,10,24,0.78)" },
        { "offset": "100%", "color": "rgba(7,10,24,0.18)" }
      ]
    },
    {
      "type": "text",
      "name": "badge",
      "text": "{{BADGE}}",
      "x": "50%",
      "y": "27%",
      "font_family": "Arimo",
      "font_weight": "700",
      "font_size": "26px",
      "fill_color": "#C026D3",
      "x_alignment": "50%",
      "y_alignment": "50%",
      "background_color": "#1E0C42",
      "background_x_padding": "45%",
      "background_y_padding": "55%",
      "background_border_radius": "50%"
    },
    {
      "type": "text",
      "name": "headline",
      "text": "{{HEADLINE}}",
      "x": "50%",
      "y": "39%",
      "width": "84%",
      "height": "16%",
      "font_family": "Syne",
      "font_weight": "700",
      "font_size": null,
      "font_size_minimum": "30px",
      "font_size_maximum": "56px",
      "line_height": "114%",
      "fill_color": "#FFFFFF",
      "x_alignment": "50%",
      "y_alignment": "50%",
      "text_wrap": true
    },
    {
      "type": "text",
      "name": "body",
      "text": "{{BODY}}",
      "x": "50%",
      "y": "53%",
      "width": "78%",
      "height": "10%",
      "font_family": "Arimo",
      "font_weight": "400",
      "font_size": null,
      "font_size_minimum": "18px",
      "font_size_maximum": "26px",
      "line_height": "128%",
      "fill_color": "#FFFFFF",
      "x_alignment": "50%",
      "y_alignment": "50%",
      "text_wrap": true,
      "background_color": "rgba(7,10,24,0.72)",
      "background_x_padding": "18%",
      "background_y_padding": "35%",
      "background_border_radius": "16%"
    }
  ]
}
