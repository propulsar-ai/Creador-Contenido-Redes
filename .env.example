# ─────────────────────────────────────────────
# Propulsar Content Engine — Variables de entorno
# Copiar este archivo a .env y completar los valores
# NUNCA commitear el .env real al repositorio
# ─────────────────────────────────────────────

# ══════════════════════════════════════════════
# LOCALES — necesarias para correr el Wizard
# ══════════════════════════════════════════════

# n8n — URL del webhook trigger del workflow
# Formato: https://tu-instancia-n8n.com/webhook/propulsar-content-v3
WEBHOOK_URL=

# WhatsApp — numero que recibira las aprobaciones
# Formato: codigo de pais + numero, sin espacios (ej: +34612345678)
WHATSAPP_APPROVAL_NUMBER=

# Anthropic — para sugerencia de angulos en el Wizard
# Obtener en: console.anthropic.com
ANTHROPIC_API_KEY=

# Perplexity — trending topics en tiempo real (OPCIONAL)
# Si no se configura, el Wizard usa temas de respaldo curados
# Obtener en: perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# ══════════════════════════════════════════════
# EN N8N — estas NO van en local
# Se configuran como variables de entorno en el
# servidor/contenedor donde corre n8n
# ══════════════════════════════════════════════
#
# OPENAI_API_KEY        — GPT-4o para generar texto
# FAL_API_KEY           — Flux 2 Pro + Nano Banana Pro (imagenes)
# IDEOGRAM_API_KEY      — Ideogram v3 (texto en imagen)
# YCLOUD_API_KEY        — Envio de WhatsApp
# YCLOUD_WHATSAPP_NUMBER — Numero WA Business
# META_PAGE_TOKEN       — Publicar en Instagram + Facebook
# INSTAGRAM_ACCOUNT_ID  — ID cuenta IG Business
# FACEBOOK_PAGE_ID      — ID pagina de Facebook
# GOOGLE_SHEETS_ID      — Log de publicaciones
#
# Phase 12.3 — Estado entre webhooks: Azure PostgreSQL (servidor propulsar-db,
# database content_engine). La autenticacion NO usa env vars: es una credencial
# nativa de n8n ("Postgres - content_engine"), password desde Key Vault
# propulsar-prod-kv/db-postgresdb-password. Supabase fue eliminado (proyecto
# borrado 2026-08-01) y NO se recrea.
#
# Phase 12.1 — Azure Front Door hostname fronting propulsarcontent Blob container.
# SUPERSEDED (Phase 12.1 FAILED 2026-04-23): Meta rejects all AFD hostnames
# (default + custom domain). Kept only as historical/audit-trail reference — do not delete.
# AZURE_CDN_HOST=

# Phase 12.2 — Hostinger VPS re-host service (upload/serve/delete via rehost-service on
# EasyPanel), replaces Azure Blob as the Meta-facing image host. These live as env vars /
# Key-Vault-backed secretRefs on the propulsar-n8n Container App, not in local .env.
# HOSTINGER_REHOST_BASE_URL — full https URL, no trailing slash
#   (ej: https://rehost-service-propulsar-atiende-demo.bacu5y.easypanel.host)
# HOSTINGER_REHOST_API_KEY  — shared-secret header value (Key Vault propulsar-prod-kv,
#   secret hostinger-rehost-api-key), sent as X-Api-Key on PUT/DELETE only (GET is public)
# HOSTINGER_REHOST_BASE_URL=
# HOSTINGER_REHOST_API_KEY=
